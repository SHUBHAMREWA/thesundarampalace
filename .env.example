# Copy to .env and fill in. Never commit .env.
# Placeholder values only in this file.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development            # development | test | staging | production

# Database
# Local: run `npm run db:local` (embedded PostgreSQL on port 54329).
# Neon: pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/sundaram_dev
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/sundaram_dev

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Scheduler (GitHub Actions → /api/cron/*)
CRON_SECRET=change-me

# Cloudinary (public media) — Phase 2
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=        # same value as CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=dev

# Email (Resend) — Phase 2
RESEND_API_KEY=
EMAIL_FROM="The Sundaram Palace <no-reply@example.test>"

# PDF documents — Phase 3 (docs/architecture.md ADR-08)
# local   = Playwright Chromium in the app (development/test)
# service = the pdf-service/ container (staging/production, e.g. Render free)
# none    = no server PDFs; staff print from the preview
PDF_RENDERER=local
PDF_SERVICE_URL=
PDF_SERVICE_SECRET=

# Monitoring — optional
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Seed — first Super Admin for local development only
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=change-me-local-only

# First Super Admin for staging/production — put these in that environment's env file
# (e.g. .env.neon), run npm run db:prod, then delete the password line.
# Only used while no Super Admin exists; never changes an existing account.
# FIRST_ADMIN_NAME=
# FIRST_ADMIN_EMAIL=
# FIRST_ADMIN_PASSWORD=
