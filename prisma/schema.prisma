// The Sundaram Palace — database schema.
// Read docs/database-design.md and the db-change-safety skill before changing.
// Phase 1: identity, permissions, settings, numbering, audit.
// Phase 2: website CMS, venue facts, public menus, leads, notifications.
// Phase 3: customers, private files, slots, bookings, quotations, money, documents.
// Phase 4: tasks, vendors, expenses, data-subject requests.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity (fields required by Better Auth + our own) ────────────────────

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  twoFactorEnabled Boolean   @default(false)
  active           Boolean   @default(true)
  lastLoginAt      DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]
  roles         UserRole[]
  assignedLeads Lead[]            @relation("LeadAssignee")
  notifications Notification[]
  ownedBookings Booking[]         @relation("BookingOwner")
  subEvents     BookingSubEvent[] @relation("SubEventAssignee")
  tasks         Task[]            @relation("TaskAssignee")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

/// Better Auth's own rate limiter for sign-in and 2FA endpoints.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limit")
}

// ─── Roles and permissions (code checks permissions, never role names) ──────

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  requires2fa Boolean          @default(false)
  system      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@map("role")
}

model Permission {
  key         String           @id
  description String
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permission")
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// ─── Settings and configurable lists ─────────────────────────────────────────

/// Typed settings sections (business, tax, numbering, booking policy, …),
/// validated by Zod in src/server/services/settings.ts.
model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("site_setting")
}

/// Lead statuses, sources, lost reasons, event types, customer categories, …
/// Logic depends only on `systemKey`, never on labels.
model LookupValue {
  id        String   @id @default(cuid())
  listKey   String
  key       String
  label     Json // { en: string, hi?: string }
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  systemKey String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([listKey, key])
  @@index([listKey, active, sortOrder])
  @@map("lookup_value")
}

/// Gap-free document numbers. `period` is a calendar year ("2026") for
/// lead/booking references and a financial year ("2026-27") for invoices.
model NumberSequence {
  type      String
  period    String
  prefix    String
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([type, period])
  @@map("number_sequence")
}

// ─── Audit and activity ──────────────────────────────────────────────────────

/// Append-only (database trigger blocks UPDATE and DELETE).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

/// Timeline entries shown on lead, customer and booking pages.
model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  actorId    String?
  kind       String
  message    String
  data       Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@map("activity_log")
}

/// Fixed-window counters for public endpoint rate limiting. Pruned daily.
model RateLimitBucket {
  key         String
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_bucket")
}

// ─── Website CMS (Phase 2) ───────────────────────────────────────────────────
// Localized text fields are Json: { en: string, hi?: string }.

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

/// Public media stored in Cloudinary. Metadata lives here, not in Cloudinary.
model MediaAsset {
  id                 String           @id @default(cuid())
  publicId           String           @unique
  resourceType       String // image | video | raw
  format             String?
  kind               MediaKind
  width              Int?
  height             Int?
  bytes              Int?
  alt                Json // { en (required), hi? }
  caption            Json?
  photographerCredit String?
  usagePermission    String?
  group              String // hero, halls, floor_plans, catering, decor, celebrations, about, gallery, brochure
  uploadedById       String?
  placements         MediaPlacement[]
  galleryItems       GalleryItem[]
  pagesHero          WebsitePage[]
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@index([group, createdAt])
  @@map("media_asset")
}

/// Ordered images attached to a hall, decor theme, etc. Assets in use can't be deleted.
model MediaPlacement {
  id        String     @id @default(cuid())
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  ownerType String // hall | decor_theme
  ownerId   String
  sortOrder Int        @default(0)

  @@unique([ownerType, ownerId, assetId])
  @@index([ownerType, ownerId, sortOrder])
  @@map("media_placement")
}

enum PageKind {
  STANDARD
  SERVICE
  LEGAL
}

/// Every public page's title, intro, body and SEO fields.
model WebsitePage {
  id          String      @id @default(cuid())
  kind        PageKind
  slug        String
  title       Json
  summary     Json?
  body        Json? // { en?: string, hi?: string } restricted Markdown
  heroAssetId String?
  heroAsset   MediaAsset? @relation(fields: [heroAssetId], references: [id], onDelete: Restrict)
  seo         Json? // { title?: Localized, description?: Localized }
  published   Boolean     @default(false)
  publishedAt DateTime?   @db.Timestamptz(3)
  sortOrder   Int         @default(0)
  updatedById String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([kind, slug])
  @@map("website_page")
}

/// Homepage blocks: order, visibility and per-section text.
model HomeSection {
  type      String   @id
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  content   Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("home_section")
}

/// Halls and lawns. The website shows only the name, description and photos
/// (photos are MediaPlacement rows, ownerType "hall"); capacity, area,
/// facilities, floor plan and tour fields were removed on 28 Oct 2026.
/// Booking fields (buffers, composite) are used from Phase 3.
model Hall {
  id                    String            @id @default(cuid())
  slug                  String            @unique
  name                  Json
  description           Json?
  published             Boolean           @default(false)
  active                Boolean           @default(true)
  sortOrder             Int               @default(0)
  setupBufferMinutes    Int               @default(0)
  teardownBufferMinutes Int               @default(0)
  isComposite           Boolean           @default(false)
  leads                 Lead[]
  /// Phase 3: a composite space ("Hall A + Hall B") occupies each member hall.
  members               HallComposition[] @relation("CompositeHall")
  memberOf              HallComposition[] @relation("MemberHall")
  slotDefinitions       SlotDefinition[]
  subEvents             BookingSubEvent[]
  occupancies           SlotOccupancy[]
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  @@index([published, sortOrder])
  @@map("hall")
}

/// Menus shared by the website (publicVisible) and, from Phase 3, the CRM.
model Menu {
  id            String        @id @default(cuid())
  name          Json
  category      String // veg | jain | non_veg | custom
  description   Json?
  publicVisible Boolean       @default(false)
  sortOrder     Int           @default(0)
  items         MenuItem[]
  packages      MenuPackage[]
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@map("menu")
}

model MenuItem {
  id          String @id @default(cuid())
  menuId      String
  menu        Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  course      String // welcome_drinks | starters | main_course | breads | rice | desserts | live_counters | other
  name        Json
  description Json?
  sortOrder   Int    @default(0)

  @@index([menuId, course, sortOrder])
  @@map("menu_item")
}

model DecorTheme {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        Json
  description Json?
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("decor_theme")
}

/// Guest reviews shown on the homepage. Only real reviews the guest agreed to
/// share (consent); never invented (CLAUDE.md rule 1). The optional photo is a
/// media_placement with ownerType "testimonial".
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  /// e.g. { en: "Wedding, December 2025" }
  event     Json?
  quote     Json
  /// 1 to 5 stars
  rating    Int
  consent   Boolean  @default(false)
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([published, createdAt])
  @@map("testimonial")
}

model GalleryCategory {
  id        String        @id @default(cuid())
  key       String        @unique
  name      Json
  sortOrder Int           @default(0)
  items     GalleryItem[]

  @@map("gallery_category")
}

model GalleryItem {
  id         String          @id @default(cuid())
  categoryId String
  category   GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assetId    String
  asset      MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  featured   Boolean         @default(false)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([categoryId, assetId])
  @@map("gallery_item")
}

/// Popular / auspicious dates supplied by the business (never computed by us).
model AuspiciousDate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  label     Json
  note      Json?
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([published, date])
  @@map("auspicious_date")
}

// ─── Blog and Real Weddings (Phase 5) ────────────────────────────────────────

model BlogCategory {
  id        String     @id @default(cuid())
  key       String     @unique
  name      Json
  sortOrder Int        @default(0)
  posts     BlogPost[]

  @@map("blog_category")
}

model BlogPost {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            Json
  summary          Json?
  content          Json
  featuredImageUrl String?
  author           String       @default("The Sundaram Palace Team")
  categoryKey      String
  category         BlogCategory @relation(fields: [categoryKey], references: [key], onDelete: Restrict)
  tags             Json?
  published        Boolean      @default(false)
  publishedAt      DateTime?    @db.Timestamptz(3)
  metaTitle        Json?
  metaDescription  Json?
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  @@index([published, publishedAt])
  @@map("blog_post")
}

model RealWeddingStory {
  id                  String    @id @default(cuid())
  slug                String    @unique
  coupleName          Json
  eventDate           DateTime? @db.Date
  eventTypeKey        String
  hallUsed            Json?
  photographerCredit  String?
  summary             Json?
  story               Json?
  coverImageUrl       String?
  galleryImageUrls    Json?
  coupleConsent       Boolean   @default(false)
  photographerConsent Boolean   @default(false)
  consentDate         DateTime? @db.Timestamptz(3)
  published           Boolean   @default(false)
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@index([published, sortOrder])
  @@map("real_wedding_story")
}

// ─── Leads and messaging (Phase 2) ───────────────────────────────────────────

model Lead {
  id                String         @id @default(cuid())
  reference         String         @unique
  statusKey         String // lookup_value(lead_status).key
  sourceKey         String // lookup_value(lead_source).key
  campaign          String?
  utm               Json?
  referrer          String?
  landingPage       String?
  locale            String         @default("en")
  eventTypeKey      String?
  preferredDate     DateTime?      @db.Date
  guestsApprox      Int?
  message           String?
  preferredHallId   String?
  preferredHall     Hall?          @relation(fields: [preferredHallId], references: [id], onDelete: SetNull)
  fullName          String
  phone             String // E.164
  email             String?
  contactPreference String // whatsapp | call | email
  assignedToId      String?
  assignedTo        User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  followUpAt        DateTime?      @db.Timestamptz(3)
  budgetEstimate    Decimal?       @db.Decimal(12, 2)
  menuPreference    String? // veg | jain | non_veg
  siteVisitAt       DateTime?      @db.Timestamptz(3)
  siteVisitOutcome  String?
  lostReasonKey     String?
  lastActivityAt    DateTime       @default(now()) @db.Timestamptz(3)
  deletedAt         DateTime?      @db.Timestamptz(3)
  /// Set when the lead is converted (Phase 3).
  customerId        String?
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookings          Booking[]
  tasks             Task[]
  activities        LeadActivity[]
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  @@index([phone])
  @@index([statusKey, createdAt])
  @@index([assignedToId, followUpAt])
  @@index([createdAt])
  @@index([customerId])
  @@map("lead")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  kind      String // CREATED | MERGED_ENQUIRY | CALL | WHATSAPP | VISIT | NOTE | STATUS_CHANGE | ASSIGNED | FOLLOW_UP | UPDATED
  note      String?
  data      Json?
  actorId   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([leadId, createdAt])
  @@map("lead_activity")
}

/// One row per consent change; the latest row for (subject, purpose) wins.
model ConsentRecord {
  id            String   @id @default(cuid())
  subjectType   String // LEAD | CUSTOMER | PARTY
  subjectId     String
  purpose       String // contact | brochure | site_visit | marketing_whatsapp | marketing_email | greetings
  granted       Boolean
  noticeVersion String
  source        String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([subjectType, subjectId, purpose, createdAt])
  @@map("consent_record")
}

/// In-app notifications for staff.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  link      String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

/// Outgoing email/WhatsApp/SMS, and the message log. Never claims "sent"
/// without a provider. WhatsApp rows move SENT → DELIVERED → READ (or FAILED)
/// from the provider's webhooks.
model Outbox {
  id                String           @id @default(cuid())
  channel           String // email | whatsapp | sms
  template          String
  toAddress         String
  payload           Json
  purpose           String
  status            String           @default("PENDING") // PENDING | SENT | DELIVERED | READ | FAILED | NOT_SENT_NO_PROVIDER | SKIPPED_NO_CONSENT
  attempts          Int              @default(0)
  nextAttemptAt     DateTime?        @db.Timestamptz(3)
  lastError         String?
  provider          String? // meta | twilio | resend
  providerMessageId String?
  sentAt            DateTime?        @db.Timestamptz(3)
  deliveredAt       DateTime?        @db.Timestamptz(3)
  readAt            DateTime?        @db.Timestamptz(3)
  failedAt          DateTime?        @db.Timestamptz(3)
  campaignId        String?
  campaign          MessageCampaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdById       String?
  relatedType       String?
  relatedId         String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([relatedType, relatedId])
  @@index([channel, createdAt])
  @@index([campaignId])
  @@index([providerMessageId])
  @@map("outbox")
}

/// One bulk WhatsApp send: an approved template sent to a filtered audience.
model MessageCampaign {
  id               String   @id @default(cuid())
  name             String
  channel          String   @default("whatsapp")
  provider         String // meta | twilio
  templateName     String
  /// Meta: language code. Twilio: Content SID.
  templateRef      String
  templateCategory String // MARKETING | UTILITY | AUTHENTICATION
  /// Values for {{1}}, {{2}}, …; "{name}" becomes each recipient's first name.
  variables        Json
  /// The audience filters used, kept for the record.
  audience         Json
  recipientCount   Int
  skippedCount     Int      @default(0)
  createdById      String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  messages         Outbox[]

  @@index([createdAt])
  @@map("message_campaign")
}

/// Replies and messages customers send to the business WhatsApp number.
model InboundMessage {
  id                String   @id @default(cuid())
  channel           String   @default("whatsapp")
  provider          String // meta | twilio
  fromAddress       String // E.164
  body              String
  providerMessageId String   @unique
  relatedType       String? // lead | customer (matched by phone)
  relatedId         String?
  receivedAt        DateTime @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@index([receivedAt])
  @@index([fromAddress])
  @@index([relatedType, relatedId])
  @@map("inbound_message")
}

/// Conversion counts for reports. Never stores names, phones or emails.
model ConversionEvent {
  id        String   @id @default(cuid())
  type      String // enquiry_submitted | whatsapp_click | call_click | brochure_download | site_visit_booked | date_check_used
  page      String?
  locale    String?
  utm       Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([type, createdAt])
  @@map("conversion_event")
}

// ─── Customers and private files (Phase 3) ───────────────────────────────────

/// Private customer records: never on the website, never in public URLs.
/// Age is computed from dateOfBirth, never stored.
model Customer {
  id              String             @id @default(cuid())
  reference       String             @unique
  fullName        String
  mobile          String // E.164
  whatsapp        String?
  email           String?
  gstin           String?
  companyName     String?
  maritalStatus   String? // single | married | other | prefer_not_to_say
  dateOfBirth     DateTime?          @db.Date
  /// Used only when the date of birth is unknown: birth year from an approximate age.
  approxBirthYear Int?
  anniversary     DateTime?          @db.Date
  spouseName      String?
  categoryKey     String? // lookup_value(customer_category).key
  professionKeys  String[]           @default([]) // lookup_value(profession).key
  professionOther String?
  stateCode       String? // GST state code; default place of supply
  city            String?
  locality        String?
  address         String?
  mapsUrl         String?
  /// Private-store key of the profile photo (Cloudinary "authenticated" WebP when configured).
  photoKey        String?
  notes           String?
  createdById     String?
  /// Set when this record was merged into another customer.
  mergedIntoId    String?
  deletedAt       DateTime?          @db.Timestamptz(3)
  anonymizedAt    DateTime?          @db.Timestamptz(3)
  leads           Lead[]
  bookings        Booking[]
  documents       CustomerDocument[]
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)

  @@index([mobile])
  @@index([fullName])
  /// Partial-name search (pg_trgm, created in phase3_integrity).
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_fullName_trgm_idx")
  @@index([deletedAt, createdAt])
  @@map("customer")
}

/// Possible duplicates waiting for a person to decide. Merging is never automatic.
model CustomerMergeReview {
  id          String    @id @default(cuid())
  primaryId   String
  duplicateId String
  reason      String // SAME_MOBILE | MANUAL
  status      String    @default("PENDING") // PENDING | MERGED | DISMISSED
  note        String?
  createdById String?
  decidedById String?
  decidedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([primaryId, duplicateId])
  @@index([status, createdAt])
  @@map("customer_merge_review")
}

/// Photos and identity documents (PAN, masked Aadhaar, other). The bytes live
/// in the private store (PrivateBlob); there is no column for ID numbers.
model CustomerDocument {
  id           String           @id @default(cuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  partyId      String?
  party        BrideGroomParty? @relation(fields: [partyId], references: [id], onDelete: Restrict)
  category     String // PHOTO | AADHAAR_MASKED | PAN | VOTER_ID | DRIVING_LICENCE | PASSPORT | OTHER
  /// ID number as stored: Aadhaar keeps only the last 4 digits ("XXXX XXXX 1234").
  idNumber     String?
  label        String?
  purpose      String?
  storageKey   String           @unique
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedById String?
  deletedAt    DateTime?        @db.Timestamptz(3)
  deletedById  String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@index([partyId])
  @@map("customer_document")
}

/// Private file bytes (architecture.md ADR-07). There is no URL for these:
/// they are streamed only by permission-checked, audit-logged routes.
model PrivateBlob {
  key       String   @id
  data      Bytes
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("private_blob")
}

// ─── Venue booking rules (Phase 3) ───────────────────────────────────────────

/// "Hall A + Hall B": booking the composite hall occupies every member hall.
model HallComposition {
  compositeHallId String
  compositeHall   Hall   @relation("CompositeHall", fields: [compositeHallId], references: [id], onDelete: Cascade)
  memberHallId    String
  memberHall      Hall   @relation("MemberHall", fields: [memberHallId], references: [id], onDelete: Restrict)

  @@id([compositeHallId, memberHallId])
  @@index([memberHallId])
  @@map("hall_composition")
}

/// Slot times are Asia/Kolkata wall-clock times from the business. An end
/// time at or before the start time means the slot ends the next day.
model SlotDefinition {
  id        String            @id @default(cuid())
  hallId    String? // null = every hall
  hall      Hall?             @relation(fields: [hallId], references: [id], onDelete: Cascade)
  name      String
  startTime String // HH:mm
  endTime   String // HH:mm
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  subEvents BookingSubEvent[]
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@index([hallId, active, sortOrder])
  @@map("slot_definition")
}

// ─── Catalog and pricing (Phase 3) ───────────────────────────────────────────

/// A kind of taxable supply (e.g. hall rental, catering) with its SAC code.
/// Rates are versioned in TaxRate; both must be confirmed by the accountant.
model TaxCategory {
  id           String        @id @default(cuid())
  name         String
  sacCode      String
  notes        String?
  active       Boolean       @default(true)
  rates        TaxRate[]
  services     ServiceItem[]
  menuPackages MenuPackage[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  @@map("tax_category")
}

/// GST rate from a date onwards. New quotation lines use the rate in force on
/// the day they are priced; issued documents keep the rate they were issued with.
model TaxRate {
  id            String      @id @default(cuid())
  taxCategoryId String
  taxCategory   TaxCategory @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)
  ratePercent   Decimal     @db.Decimal(5, 2)
  effectiveFrom DateTime    @db.Date
  createdById   String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([taxCategoryId, effectiveFrom])
  @@map("tax_rate")
}

/// Chargeable services for quotations (hall rental, décor, lighting, …). No room services.
model ServiceItem {
  id            String       @id @default(cuid())
  name          String
  categoryKey   String // lookup_value(service_category).key
  description   String?
  unit          String // e.g. "per event", "per hour"
  defaultPrice  Decimal?     @db.Decimal(12, 2)
  /// Unused since 26 Oct 2026: the business charges no GST.
  taxCategoryId String?
  taxCategory   TaxCategory? @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)
  active        Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@index([active, sortOrder])
  @@map("service_item")
}

/// A priced menu: per-plate rate plus how many items guests choose per course.
model MenuPackage {
  id             String                  @id @default(cuid())
  menuId         String
  menu           Menu                    @relation(fields: [menuId], references: [id], onDelete: Restrict)
  name           String
  perPlateRate   Decimal                 @db.Decimal(12, 2)
  minPlates      Int?
  /// [{ course: "starters", choose: 3 }] — items come from the menu's course.
  selectionRules Json
  /// Unused since 26 Oct 2026: plates use the Catering GST from Settings → Tax.
  taxCategoryId  String?
  taxCategory    TaxCategory?            @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)
  active         Boolean                 @default(true)
  sortOrder      Int                     @default(0)
  selections     SubEventMenuSelection[]
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)

  @@index([menuId])
  @@map("menu_package")
}

enum PricingRuleKind {
  SEASON
  WEEKDAY
  DATE
}

enum AdjustmentType {
  PERCENT
  AMOUNT
}

/// Season / weekday / named-date adjustments. Applied only when a new
/// quotation line is priced; never to existing quotations or invoices.
model PricingRule {
  id              String          @id @default(cuid())
  name            String
  kind            PricingRuleKind
  startDate       DateTime?       @db.Date
  endDate         DateTime?       @db.Date
  weekdays        Json? // [0..6], 0 = Sunday
  dates           Json? // ["2026-11-20", …]
  adjustmentType  AdjustmentType
  adjustmentValue Decimal         @db.Decimal(12, 2) // may be negative (a discount)
  appliesTo       String // ALL | PLATES | PACKAGE | SERVICE
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@map("pricing_rule")
}

/// Refund slabs [{ daysBeforeEventMin, refundPercent }], snapshotted onto a booking when it is confirmed.
model CancellationPolicy {
  id          String   @id @default(cuid())
  name        String
  description String?
  slabs       Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("cancellation_policy")
}

// ─── Bookings (Phase 3) ──────────────────────────────────────────────────────

enum BookingStatus {
  ENQUIRY_HOLD
  TENTATIVE
  QUOTATION_SENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReservationState {
  HOLD
  TENTATIVE
  CONFIRMED
  RELEASED
  CANCELLED
}

/// Totals are never stored here: they come from the accepted quotation,
/// post-event charges and the ledger.
model Booking {
  id                         String                 @id @default(cuid())
  reference                  String                 @unique
  customerId                 String
  customer                   Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  leadId                     String?
  lead                       Lead?                  @relation(fields: [leadId], references: [id], onDelete: Restrict)
  mainEventName              String
  mainEventTypeKey           String
  status                     BookingStatus          @default(ENQUIRY_HOLD)
  /// Event dates (from – to), entered on the booking; functions outside the range widen it.
  startDate                  DateTime?              @db.Date
  endDate                    DateTime?              @db.Date
  expectedGuests             Int?
  ownerId                    String?
  owner                      User?                  @relation("BookingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  placeOfSupplyStateCode     String?
  acceptedQuotationId        String?                @unique
  acceptedQuotation          QuotationVersion?      @relation("AcceptedQuotation", fields: [acceptedQuotationId], references: [id], onDelete: Restrict)
  /// Unused since 26 Oct 2026 (no GST).
  foodGst                    Boolean                @default(false)
  cancellationPolicySnapshot Json?
  depositRequired            Decimal?               @db.Decimal(12, 2)
  /// What the booking was agreed for, entered when it is made. An accepted quotation's total takes over once there is one.
  bookingAmount              Decimal?               @db.Decimal(12, 2)
  /// The day the booking was taken (defaults to the day it was entered).
  bookedOn                   DateTime?              @db.Date
  /// This booking's own copy of the food menu with the items picked for it (null: not made yet).
  foodMenu                   Json?
  notes                      String?
  internalInstructions       String?
  confirmedAt                DateTime?              @db.Timestamptz(3)
  confirmedById              String?
  cancelledAt                DateTime?              @db.Timestamptz(3)
  /// { reason, daysBefore, slabPercent, computedRefund, agreedRefund, overridden }
  cancellation               Json?
  createdById                String?
  deletedAt                  DateTime?              @db.Timestamptz(3)
  subEvents                  BookingSubEvent[]
  parties                    BrideGroomParty[]
  quotations                 QuotationVersion[]     @relation("BookingQuotations")
  ledger                     LedgerEntry[]
  instalments                PaymentInstalment[]
  depositEntries             DepositEntry[]
  postEventCharges           PostEventCharge[]
  invoices                   Invoice[]
  creditNotes                CreditNote[]
  statusHistory              BookingStatusHistory[]
  documents                  GeneratedDocument[]
  tasks                      Task[]
  vendorAssignments          VendorAssignment[]
  expenses                   Expense[]
  createdAt                  DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime               @updatedAt @db.Timestamptz(3)

  @@index([customerId])
  @@index([status, startDate])
  @@index([startDate])
  @@index([ownerId])
  @@map("booking")
}

/// One function of a booking (haldi, sangeet, wedding, …) with its own date and hall.
model BookingSubEvent {
  id                  String                 @id @default(cuid())
  bookingId           String
  booking             Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  name                String
  eventTypeKey        String // lookup_value(sub_event_type).key
  date                DateTime               @db.Date
  hallId              String
  hall                Hall                   @relation(fields: [hallId], references: [id], onDelete: Restrict)
  slotDefinitionId    String?
  slotDefinition      SlotDefinition?        @relation(fields: [slotDefinitionId], references: [id], onDelete: SetNull)
  startsAt            DateTime               @db.Timestamptz(3)
  endsAt              DateTime               @db.Timestamptz(3)
  expectedGuests      Int?
  assignedToId        String?
  assignedTo          User?                  @relation("SubEventAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  specialInstructions String?
  internalNotes       String?
  dietaryNotes        String?
  sortOrder           Int                    @default(0)
  reservation         SlotReservation?
  menuSelection       SubEventMenuSelection?
  postEventCharges    PostEventCharge[]
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)

  @@index([bookingId, sortOrder])
  @@index([hallId, startsAt])
  @@index([date])
  @@index([assignedToId, date])
  @@map("booking_sub_event")
}

/// The hall time a sub-event holds. Expired holds are released (lazily on
/// read and by the hourly job); a hold on a taken slot is a waitlist entry.
model SlotReservation {
  id                 String           @id @default(cuid())
  subEventId         String           @unique
  subEvent           BookingSubEvent  @relation(fields: [subEventId], references: [id], onDelete: Cascade)
  hallId             String
  startsAt           DateTime         @db.Timestamptz(3)
  endsAt             DateTime         @db.Timestamptz(3)
  state              ReservationState
  holdExpiresAt      DateTime?        @db.Timestamptz(3)
  holdReminderSentAt DateTime?        @db.Timestamptz(3)
  waitlistPosition   Int?
  overrideReason     String?
  overrideById       String?
  occupancies        SlotOccupancy[]
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@index([state, holdExpiresAt])
  @@index([hallId, startsAt])
  @@map("slot_reservation")
}

/// One row per physical hall (composites expand to their members), with the
/// setup/teardown buffers applied. The exclusion constraint that stops two
/// confirmed bookings overlapping lives on this table (raw SQL migration).
model SlotOccupancy {
  id                String           @id @default(cuid())
  reservationId     String
  reservation       SlotReservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  physicalHallId    String
  physicalHall      Hall             @relation(fields: [physicalHallId], references: [id], onDelete: Restrict)
  effectiveStartsAt DateTime         @db.Timestamptz(3)
  effectiveEndsAt   DateTime         @db.Timestamptz(3)
  state             ReservationState
  allowOverlap      Boolean          @default(false)

  @@index([physicalHallId, effectiveStartsAt])
  @@index([reservationId])
  @@map("slot_occupancy")
}

enum PartyRole {
  BRIDE
  GROOM
}

model BrideGroomParty {
  id        String             @id @default(cuid())
  bookingId String
  booking   Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  role      PartyRole
  fullName  String
  mobile    String?
  email     String?
  altPhone  String?
  notes     String?
  documents CustomerDocument[]
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([bookingId, role])
  @@map("bride_groom_party")
}

/// Append-only.
model BookingStatusHistory {
  id         String         @id @default(cuid())
  bookingId  String
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  fromStatus BookingStatus?
  toStatus   BookingStatus
  reason     String?
  actorId    String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

/// The menu chosen for a sub-event; `snapshot` keeps the items and rate as agreed.
model SubEventMenuSelection {
  id                 String          @id @default(cuid())
  subEventId         String          @unique
  subEvent           BookingSubEvent @relation(fields: [subEventId], references: [id], onDelete: Cascade)
  menuPackageId      String
  menuPackage        MenuPackage     @relation(fields: [menuPackageId], references: [id], onDelete: Restrict)
  /// { menuName, category, packageName, perPlateRate, minPlates, items: [{ course, name }] }
  snapshot           Json
  guaranteedPlates   Int
  actualPlates       Int?
  actualRecordedAt   DateTime?       @db.Timestamptz(3)
  actualRecordedById String?
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  @@index([menuPackageId])
  @@map("sub_event_menu_selection")
}

// ─── Quotations (Phase 3) ────────────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  SUPERSEDED
}

enum SupplyType {
  INTRA
  INTER
}

enum LineKind {
  PACKAGE
  PLATES
  SERVICE
  CUSTOM
  EXTRA_PLATES
}

/// Immutable once SENT (database trigger): changes create the next version.
model QuotationVersion {
  id                     String          @id @default(cuid())
  bookingId              String
  booking                Booking         @relation("BookingQuotations", fields: [bookingId], references: [id], onDelete: Restrict)
  versionNumber          Int
  status                 QuotationStatus @default(DRAFT)
  pricesIncludeTax       Boolean
  supplyType             SupplyType
  placeOfSupplyStateCode String
  roundGrandTotal        Boolean         @default(false)
  bookingDiscount        Decimal         @default(0) @db.Decimal(12, 2)
  subtotal               Decimal         @default(0) @db.Decimal(12, 2)
  discountTotal          Decimal         @default(0) @db.Decimal(12, 2)
  taxableTotal           Decimal         @default(0) @db.Decimal(12, 2)
  cgstTotal              Decimal         @default(0) @db.Decimal(12, 2)
  sgstTotal              Decimal         @default(0) @db.Decimal(12, 2)
  igstTotal              Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal               Decimal         @default(0) @db.Decimal(12, 2)
  roundOff               Decimal         @default(0) @db.Decimal(12, 2)
  grandTotal             Decimal         @default(0) @db.Decimal(12, 2)
  validUntil             DateTime?       @db.Date
  terms                  String?
  notes                  String?
  /// Menus and sub-events as quoted, cancellation policy, pricing rules applied.
  snapshot               Json?
  sentAt                 DateTime?       @db.Timestamptz(3)
  acceptedAt             DateTime?       @db.Timestamptz(3)
  acceptedById           String?
  createdById            String?
  lines                  QuotationLine[]
  acceptedFor            Booking?        @relation("AcceptedQuotation")
  invoices               Invoice[]
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([bookingId, versionNumber])
  @@map("quotation_version")
}

model QuotationLine {
  id                String           @id @default(cuid())
  versionId         String
  version           QuotationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sortOrder         Int              @default(0)
  kind              LineKind
  /// Plain reference: the quoted text stays even if the sub-event changes.
  subEventId        String?
  subEventLabel     String?
  description       String
  sacCode           String
  unit              String
  quantity          Decimal          @db.Decimal(12, 3)
  unitPrice         Decimal          @db.Decimal(12, 2)
  discount          Decimal          @default(0) @db.Decimal(12, 2)
  /// This line's share of the quotation-level discount.
  allocatedDiscount Decimal          @default(0) @db.Decimal(12, 2)
  taxRatePercent    Decimal          @db.Decimal(5, 2)
  taxableValue      Decimal          @db.Decimal(12, 2)
  cgst              Decimal          @db.Decimal(12, 2)
  sgst              Decimal          @db.Decimal(12, 2)
  igst              Decimal          @db.Decimal(12, 2)
  lineTotal         Decimal          @db.Decimal(12, 2)
  taxCategoryId     String?
  /// { type: package|menu_package|service, id, pricingRuleIds }
  source            Json?

  @@index([versionId, sortOrder])
  @@map("quotation_line")
}

// ─── Money (Phase 3) — append-only tables, see the migration triggers ────────

enum LedgerType {
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum LedgerDirection {
  IN // money received from the customer (or a correction upwards)
  OUT // money returned (or a correction downwards)
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD_OFFLINE
  CHEQUE
  OTHER
}

/// Per-booking ledger. Never updated or deleted; mistakes are reversed with
/// an ADJUSTMENT that points at the entry it reverses.
model LedgerEntry {
  id              String          @id @default(cuid())
  bookingId       String
  booking         Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  type            LedgerType
  direction       LedgerDirection
  amount          Decimal         @db.Decimal(12, 2)
  occurredOn      DateTime        @db.Date
  method          PaymentMethod?
  transactionRef  String?
  receiptNumber   String?         @unique
  reason          String?
  notes           String?
  reversesEntryId String?         @unique
  reverses        LedgerEntry?    @relation("Reversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy      LedgerEntry?    @relation("Reversal")
  recordedById    String
  idempotencyKey  String          @unique
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  @@index([bookingId, occurredOn])
  @@index([occurredOn])
  @@map("ledger_entry")
}

/// The payment schedule. Paid status is computed from the ledger.
model PaymentInstalment {
  id             String    @id @default(cuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  label          String
  dueOn          DateTime  @db.Date
  amount         Decimal   @db.Decimal(12, 2)
  sortOrder      Int       @default(0)
  reminderSentOn DateTime? @db.Date
  createdById    String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([bookingId, dueOn])
  @@index([dueOn])
  @@map("payment_instalment")
}

enum DepositEntryType {
  RECEIVED
  DEDUCTION
  REFUNDED
}

/// Security deposit ledger, kept apart from revenue. Append-only.
model DepositEntry {
  id             String           @id @default(cuid())
  bookingId      String
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  type           DepositEntryType
  amount         Decimal          @db.Decimal(12, 2)
  occurredOn     DateTime         @db.Date
  method         PaymentMethod?
  transactionRef String?
  reason         String?
  recordedById   String
  idempotencyKey String           @unique
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  @@index([bookingId, createdAt])
  @@map("deposit_entry")
}

enum PostEventChargeKind {
  EXTRA_PLATES
  EXTRA_HOURS
  OTHER
}

/// Charges recorded after an event (extra plates, extra hours). Append-only.
model PostEventCharge {
  id               String              @id @default(cuid())
  bookingId        String
  booking          Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  subEventId       String?
  subEvent         BookingSubEvent?    @relation(fields: [subEventId], references: [id], onDelete: Restrict)
  kind             PostEventChargeKind
  description      String
  sacCode          String
  unit             String
  quantity         Decimal             @db.Decimal(12, 3)
  unitPrice        Decimal             @db.Decimal(12, 2)
  taxRatePercent   Decimal             @db.Decimal(5, 2)
  pricesIncludeTax Boolean
  supplyType       SupplyType
  taxableValue     Decimal             @db.Decimal(12, 2)
  cgst             Decimal             @db.Decimal(12, 2)
  sgst             Decimal             @db.Decimal(12, 2)
  igst             Decimal             @db.Decimal(12, 2)
  lineTotal        Decimal             @db.Decimal(12, 2)
  recordedById     String
  idempotencyKey   String              @unique
  invoiceLines     InvoiceLine[]
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)

  @@index([bookingId])
  @@map("post_event_charge")
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_CREDITED
  FULLY_CREDITED
}

/// GST tax invoice. Immutable after issue; only `status` changes (trigger).
model Invoice {
  id                     String            @id @default(cuid())
  number                 String            @unique
  financialYear          String
  sequence               Int
  bookingId              String
  booking                Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  quotationVersionId     String?
  quotationVersion       QuotationVersion? @relation(fields: [quotationVersionId], references: [id], onDelete: Restrict)
  issuedOn               DateTime          @db.Date
  /// Business details as printed (legal name, GSTIN, address, state).
  supplier               Json
  /// Customer details as printed (name, address, GSTIN, state).
  recipient              Json
  placeOfSupplyStateCode String
  supplyType             SupplyType
  pricesIncludeTax       Boolean
  taxableTotal           Decimal           @db.Decimal(12, 2)
  cgstTotal              Decimal           @db.Decimal(12, 2)
  sgstTotal              Decimal           @db.Decimal(12, 2)
  igstTotal              Decimal           @db.Decimal(12, 2)
  taxTotal               Decimal           @db.Decimal(12, 2)
  roundOff               Decimal           @default(0) @db.Decimal(12, 2)
  grandTotal             Decimal           @db.Decimal(12, 2)
  amountInWords          String
  status                 InvoiceStatus     @default(ISSUED)
  notes                  String?
  issuedById             String
  idempotencyKey         String            @unique
  lines                  InvoiceLine[]
  creditNotes            CreditNote[]
  createdAt              DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([financialYear, sequence])
  @@index([bookingId])
  @@index([issuedOn])
  @@map("invoice")
}

model InvoiceLine {
  id                String           @id @default(cuid())
  invoiceId         String
  invoice           Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  sortOrder         Int
  description       String
  sacCode           String
  unit              String
  quantity          Decimal          @db.Decimal(12, 3)
  unitPrice         Decimal          @db.Decimal(12, 2)
  discount          Decimal          @db.Decimal(12, 2)
  taxableValue      Decimal          @db.Decimal(12, 2)
  ratePercent       Decimal          @db.Decimal(5, 2)
  cgst              Decimal          @db.Decimal(12, 2)
  sgst              Decimal          @db.Decimal(12, 2)
  igst              Decimal          @db.Decimal(12, 2)
  lineTotal         Decimal          @db.Decimal(12, 2)
  quotationLineId   String?
  postEventChargeId String?          @unique
  postEventCharge   PostEventCharge? @relation(fields: [postEventChargeId], references: [id], onDelete: Restrict)
  creditNoteLines   CreditNoteLine[]

  @@index([invoiceId, sortOrder])
  @@map("invoice_line")
}

/// Corrections to an issued invoice (cancellations, reductions). Own number sequence. Append-only.
model CreditNote {
  id             String           @id @default(cuid())
  number         String           @unique
  financialYear  String
  sequence       Int
  invoiceId      String
  invoice        Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  bookingId      String
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  issuedOn       DateTime         @db.Date
  reason         String
  supplyType     SupplyType
  taxableTotal   Decimal          @db.Decimal(12, 2)
  cgstTotal      Decimal          @db.Decimal(12, 2)
  sgstTotal      Decimal          @db.Decimal(12, 2)
  igstTotal      Decimal          @db.Decimal(12, 2)
  taxTotal       Decimal          @db.Decimal(12, 2)
  grandTotal     Decimal          @db.Decimal(12, 2)
  amountInWords  String
  issuedById     String
  idempotencyKey String           @unique
  lines          CreditNoteLine[]
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([financialYear, sequence])
  @@index([invoiceId])
  @@index([bookingId])
  @@map("credit_note")
}

model CreditNoteLine {
  id            String      @id @default(cuid())
  creditNoteId  String
  creditNote    CreditNote  @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  invoiceLineId String
  invoiceLine   InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)
  description   String
  sacCode       String
  taxableValue  Decimal     @db.Decimal(12, 2)
  ratePercent   Decimal     @db.Decimal(5, 2)
  cgst          Decimal     @db.Decimal(12, 2)
  sgst          Decimal     @db.Decimal(12, 2)
  igst          Decimal     @db.Decimal(12, 2)
  lineTotal     Decimal     @db.Decimal(12, 2)

  @@index([creditNoteId])
  @@index([invoiceLineId])
  @@map("credit_note_line")
}

// ─── Documents (Phase 3) ─────────────────────────────────────────────────────

/// Saved field selections for the PDF/print dialog. ownerId null = shared.
model DocumentPreset {
  id           String   @id @default(cuid())
  name         String
  documentType String
  template     String
  fields       Json // ["customer.name", …]
  ownerId      String?
  createdById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([documentType, ownerId])
  @@map("document_preset")
}

/// Every generated document: who, which fields, which template, and a hash.
/// The PDF bytes (when a renderer is configured) are in the private store. Append-only.
model GeneratedDocument {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  documentType String
  template     String
  fields       Json
  reference    String
  sourceId     String?
  version      Int
  format       String // pdf | html
  sha256       String
  storageKey   String?  @unique
  sizeBytes    Int?
  createdById  String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([bookingId, documentType, createdAt])
  @@map("generated_document")
}

// ─── Operations (Phase 4) ────────────────────────────────────────────────────

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// A reusable checklist (e.g. "Wedding event checklist"). Templates marked
/// autoOnConfirm create their tasks when a booking is confirmed.
model TaskTemplate {
  id            String             @id @default(cuid())
  name          String
  description   String?
  /// Only for these main event types (empty = all).
  eventTypeKeys Json               @default("[]")
  autoOnConfirm Boolean            @default(false)
  active        Boolean            @default(true)
  items         TaskTemplateItem[]
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  @@map("task_template")
}

model TaskTemplateItem {
  id          String       @id @default(cuid())
  templateId  String
  template    TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// Due date relative to the first function (negative = before).
  offsetDays  Int          @default(0)
  priority    TaskPriority @default(NORMAL)
  /// Default assignee; null = the booking's owner.
  assigneeId  String?
  sortOrder   Int          @default(0)

  @@index([templateId, sortOrder])
  @@map("task_template_item")
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  assigneeId    String?
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueAt         DateTime?    @db.Timestamptz(3)
  priority      TaskPriority @default(NORMAL)
  status        TaskStatus   @default(OPEN)
  bookingId     String?
  booking       Booking?     @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  subEventId    String?
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  customerId    String?
  templateId    String?
  completedAt   DateTime?    @db.Timestamptz(3)
  completedById String?
  createdById   String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@index([assigneeId, status, dueAt])
  @@index([bookingId])
  @@index([status, dueAt])
  @@map("task")
}

model Vendor {
  id          String             @id @default(cuid())
  name        String
  categoryKey String // lookup_value(vendor_category).key
  contactName String?
  phone       String?
  email       String?
  partner     Boolean            @default(false)
  notes       String?
  active      Boolean            @default(true)
  assignments VendorAssignment[]
  expenses    Expense[]
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  @@index([categoryKey, active])
  @@map("vendor")
}

model VendorAssignment {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  subEventId  String?
  service     String
  notes       String?
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([bookingId])
  @@index([vendorId])
  @@map("vendor_assignment")
}

enum ExpensePaymentStatus {
  UNPAID
  PARTLY_PAID
  PAID
}

/// Booking-related (or general) costs. Changes are audit-logged with before/after values.
model Expense {
  id            String               @id @default(cuid())
  bookingId     String?
  booking       Booking?             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  categoryKey   String // lookup_value(expense_category).key
  vendorId      String?
  vendor        Vendor?              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  description   String
  amount        Decimal              @db.Decimal(12, 2)
  incurredOn    DateTime             @db.Date
  paymentStatus ExpensePaymentStatus @default(UNPAID)
  notes         String?
  recordedById  String
  deletedAt     DateTime?            @db.Timestamptz(3)
  deletedReason String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)

  @@index([bookingId])
  @@index([incurredOn])
  @@map("expense")
}

enum DataRequestKind {
  ACCESS
  CORRECTION
  DELETION
}

enum DataRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
}

/// DPDP Act requests from a person about their own data (access, correction, deletion).
model DataSubjectRequest {
  id          String            @id @default(cuid())
  reference   String            @unique
  subjectType String // LEAD | CUSTOMER
  subjectId   String
  kind        DataRequestKind
  status      DataRequestStatus @default(OPEN)
  details     String
  receivedOn  DateTime          @db.Date
  dueOn       DateTime          @db.Date
  resolution  String?
  handledById String?
  completedAt DateTime?         @db.Timestamptz(3)
  createdById String
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([status, dueOn])
  @@index([subjectType, subjectId])
  @@map("data_subject_request")
}
