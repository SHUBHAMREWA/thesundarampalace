// The Sundaram Palace — database schema.
// Read docs/database-design.md and the db-change-safety skill before changing.
// Phase 1: identity, permissions, settings, numbering, audit.
// Phase 2: website CMS, venue facts, public menus, leads, notifications.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity (fields required by Better Auth + our own) ────────────────────

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  twoFactorEnabled Boolean   @default(false)
  active           Boolean   @default(true)
  lastLoginAt      DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]
  roles         UserRole[]
  assignedLeads Lead[]         @relation("LeadAssignee")
  notifications Notification[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

/// Better Auth's own rate limiter for sign-in and 2FA endpoints.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limit")
}

// ─── Roles and permissions (code checks permissions, never role names) ──────

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  requires2fa Boolean          @default(false)
  system      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@map("role")
}

model Permission {
  key         String           @id
  description String
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permission")
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// ─── Settings and configurable lists ─────────────────────────────────────────

/// Typed settings sections (business, tax, numbering, booking policy, …),
/// validated by Zod in src/server/services/settings.ts.
model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("site_setting")
}

/// Lead statuses, sources, lost reasons, event types, customer categories, …
/// Logic depends only on `systemKey`, never on labels.
model LookupValue {
  id        String   @id @default(cuid())
  listKey   String
  key       String
  label     Json // { en: string, hi?: string }
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  systemKey String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([listKey, key])
  @@index([listKey, active, sortOrder])
  @@map("lookup_value")
}

/// Gap-free document numbers. `period` is a calendar year ("2026") for
/// lead/booking references and a financial year ("2026-27") for invoices.
model NumberSequence {
  type      String
  period    String
  prefix    String
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([type, period])
  @@map("number_sequence")
}

// ─── Audit and activity ──────────────────────────────────────────────────────

/// Append-only (database trigger blocks UPDATE and DELETE).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

/// Timeline entries shown on lead, customer and booking pages.
model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  actorId    String?
  kind       String
  message    String
  data       Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@map("activity_log")
}

/// Fixed-window counters for public endpoint rate limiting. Pruned daily.
model RateLimitBucket {
  key         String
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_bucket")
}

// ─── Website CMS (Phase 2) ───────────────────────────────────────────────────
// Localized text fields are Json: { en: string, hi?: string }.

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

/// Public media stored in Cloudinary. Metadata lives here, not in Cloudinary.
model MediaAsset {
  id                 String           @id @default(cuid())
  publicId           String           @unique
  resourceType       String // image | video | raw
  format             String?
  kind               MediaKind
  width              Int?
  height             Int?
  bytes              Int?
  alt                Json // { en (required), hi? }
  caption            Json?
  photographerCredit String?
  usagePermission    String?
  group              String // hero, halls, floor_plans, catering, decor, gallery, brochure
  uploadedById       String?
  placements         MediaPlacement[]
  galleryItems       GalleryItem[]
  pagesHero          WebsitePage[]
  hallsHero          Hall[]           @relation("HallHero")
  hallsFloorPlan     Hall[]           @relation("HallFloorPlan")
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@index([group, createdAt])
  @@map("media_asset")
}

/// Ordered images attached to a hall, decor theme, etc. Assets in use can't be deleted.
model MediaPlacement {
  id        String     @id @default(cuid())
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  ownerType String // hall | decor_theme
  ownerId   String
  sortOrder Int        @default(0)

  @@unique([ownerType, ownerId, assetId])
  @@index([ownerType, ownerId, sortOrder])
  @@map("media_placement")
}

enum PageKind {
  STANDARD
  SERVICE
  LEGAL
}

/// Every public page's title, intro, body and SEO fields.
model WebsitePage {
  id          String      @id @default(cuid())
  kind        PageKind
  slug        String
  title       Json
  summary     Json?
  body        Json? // { en?: string, hi?: string } restricted Markdown
  heroAssetId String?
  heroAsset   MediaAsset? @relation(fields: [heroAssetId], references: [id], onDelete: Restrict)
  seo         Json? // { title?: Localized, description?: Localized }
  published   Boolean     @default(false)
  publishedAt DateTime?   @db.Timestamptz(3)
  sortOrder   Int         @default(0)
  updatedById String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([kind, slug])
  @@map("website_page")
}

/// Homepage blocks: order, visibility and per-section text.
model HomeSection {
  type      String   @id
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  content   Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("home_section")
}

enum HallLayout {
  THEATRE
  BANQUET
  FLOATING
  CLUSTER
}

/// Halls and lawns. Fact fields are nullable: unknown is shown as "coming soon", never 0.
/// Booking fields (buffers, composite) are used from Phase 3.
model Hall {
  id                    String               @id @default(cuid())
  slug                  String               @unique
  name                  Json
  summary               Json?
  description           Json?
  areaSqFt              Int?
  ceilingHeightFt       Decimal?             @db.Decimal(5, 2)
  facilities            Json // [{ key, note? }]
  eventTypeKeys         Json // ["wedding", ...]
  slotsInfo             Json?
  heroAssetId           String?
  heroAsset             MediaAsset?          @relation("HallHero", fields: [heroAssetId], references: [id], onDelete: Restrict)
  floorPlanAssetId      String?
  floorPlanAsset        MediaAsset?          @relation("HallFloorPlan", fields: [floorPlanAssetId], references: [id], onDelete: Restrict)
  tourUrl               String?
  seo                   Json?
  published             Boolean              @default(false)
  active                Boolean              @default(true)
  sortOrder             Int                  @default(0)
  setupBufferMinutes    Int                  @default(0)
  teardownBufferMinutes Int                  @default(0)
  isComposite           Boolean              @default(false)
  capacities            HallLayoutCapacity[]
  leads                 Lead[]
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)

  @@index([published, sortOrder])
  @@map("hall")
}

model HallLayoutCapacity {
  id        String     @id @default(cuid())
  hallId    String
  hall      Hall       @relation(fields: [hallId], references: [id], onDelete: Cascade)
  layout    HallLayout
  minGuests Int?
  maxGuests Int?

  @@unique([hallId, layout])
  @@map("hall_layout_capacity")
}

/// Menus shared by the website (publicVisible) and, from Phase 3, the CRM.
model Menu {
  id            String     @id @default(cuid())
  name          Json
  category      String // veg | jain | non_veg | custom
  description   Json?
  publicVisible Boolean    @default(false)
  sortOrder     Int        @default(0)
  items         MenuItem[]
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  @@map("menu")
}

model MenuItem {
  id          String @id @default(cuid())
  menuId      String
  menu        Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  course      String // welcome_drinks | starters | main_course | breads | rice | desserts | live_counters | other
  name        Json
  description Json?
  sortOrder   Int    @default(0)

  @@index([menuId, course, sortOrder])
  @@map("menu_item")
}

model DecorTheme {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        Json
  description Json?
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("decor_theme")
}

/// Public packages. Prices show only when an administrator enables it.
model Package {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            Json
  description     Json?
  inclusions      Json? // Localized, one item per line
  addOns          Json?
  terms           Json?
  eventTypeKeys   Json
  publicPrice     Decimal? @db.Decimal(12, 2)
  publicPriceNote Json?
  showPublicPrice Boolean  @default(false)
  published       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@map("package")
}

model GalleryCategory {
  id        String        @id @default(cuid())
  key       String        @unique
  name      Json
  sortOrder Int           @default(0)
  items     GalleryItem[]

  @@map("gallery_category")
}

model GalleryItem {
  id         String          @id @default(cuid())
  categoryId String
  category   GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assetId    String
  asset      MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  featured   Boolean         @default(false)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([categoryId, assetId])
  @@map("gallery_item")
}

/// Popular / auspicious dates supplied by the business (never computed by us).
model AuspiciousDate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  label     Json
  note      Json?
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([published, date])
  @@map("auspicious_date")
}

// ─── Leads and messaging (Phase 2) ───────────────────────────────────────────

model Lead {
  id                String         @id @default(cuid())
  reference         String         @unique
  statusKey         String // lookup_value(lead_status).key
  sourceKey         String // lookup_value(lead_source).key
  campaign          String?
  utm               Json?
  referrer          String?
  landingPage       String?
  locale            String         @default("en")
  eventTypeKey      String?
  preferredDate     DateTime?      @db.Date
  guestsApprox      Int?
  message           String?
  preferredHallId   String?
  preferredHall     Hall?          @relation(fields: [preferredHallId], references: [id], onDelete: SetNull)
  fullName          String
  phone             String // E.164
  email             String?
  contactPreference String // whatsapp | call | email
  assignedToId      String?
  assignedTo        User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  followUpAt        DateTime?      @db.Timestamptz(3)
  budgetEstimate    Decimal?       @db.Decimal(12, 2)
  menuPreference    String? // veg | jain | non_veg
  siteVisitAt       DateTime?      @db.Timestamptz(3)
  siteVisitOutcome  String?
  lostReasonKey     String?
  lastActivityAt    DateTime       @default(now()) @db.Timestamptz(3)
  deletedAt         DateTime?      @db.Timestamptz(3)
  activities        LeadActivity[]
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  @@index([phone])
  @@index([statusKey, createdAt])
  @@index([assignedToId, followUpAt])
  @@index([createdAt])
  @@map("lead")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  kind      String // CREATED | MERGED_ENQUIRY | CALL | WHATSAPP | VISIT | NOTE | STATUS_CHANGE | ASSIGNED | FOLLOW_UP | UPDATED
  note      String?
  data      Json?
  actorId   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([leadId, createdAt])
  @@map("lead_activity")
}

/// One row per consent change; the latest row for (subject, purpose) wins.
model ConsentRecord {
  id            String   @id @default(cuid())
  subjectType   String // LEAD | CUSTOMER | PARTY
  subjectId     String
  purpose       String // contact | brochure | site_visit | marketing_whatsapp | marketing_email | greetings
  granted       Boolean
  noticeVersion String
  source        String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([subjectType, subjectId, purpose, createdAt])
  @@map("consent_record")
}

/// In-app notifications for staff.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  link      String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

/// Outgoing email/WhatsApp/SMS. Never claims "sent" without a provider.
model Outbox {
  id                String    @id @default(cuid())
  channel           String // email | whatsapp | sms
  template          String
  toAddress         String
  payload           Json
  purpose           String
  status            String    @default("PENDING") // PENDING | SENT | FAILED | NOT_SENT_NO_PROVIDER | SKIPPED_NO_CONSENT
  attempts          Int       @default(0)
  nextAttemptAt     DateTime? @db.Timestamptz(3)
  lastError         String?
  providerMessageId String?
  relatedType       String?
  relatedId         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([relatedType, relatedId])
  @@map("outbox")
}

/// Conversion counts for reports. Never stores names, phones or emails.
model ConversionEvent {
  id        String   @id @default(cuid())
  type      String // enquiry_submitted | whatsapp_click | call_click | brochure_download | site_visit_booked | date_check_used
  page      String?
  locale    String?
  utm       Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([type, createdAt])
  @@map("conversion_event")
}
